# Copy to .env for local development. Examples only: never commit real secrets.

# postgres://user:pass@host:5432/db for Postgres, pglite://.data/dev for a local
# PGlite directory, or pglite://memory for a throwaway in-memory database.
DATABASE_URL=pglite://.data/dev
PORT=3100
# Public origin, no trailing slash. The OAuth callback is {PUBLIC_URL}/job-tracker/api/auth/callback.
PUBLIC_URL=http://localhost:3100

# At least 32 characters each. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
TRACKER_AGENT_KEY=replace-with-at-least-32-random-characters
# Optional second key, for rotating TRACKER_AGENT_KEY without downtime.
TRACKER_AGENT_KEY_NEXT=

# GitHub OAuth App
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
GITHUB_OAUTH_URL=https://github.com
GITHUB_API_URL=https://api.github.com
ALLOWED_GITHUB_LOGIN=devvJS

# UI build directory served under /job-tracker/
STATIC_DIR=dist
AGENT_RATE_LIMIT_PER_MINUTE=60
TRACKER_TIMEZONE=America/Detroit

# Nightly export (npm run export) to the private data repo
EXPORT_GITHUB_TOKEN=github_pat_example
EXPORT_REPO=devvJS/job-tracker-data
EXPORT_BRANCH=main
